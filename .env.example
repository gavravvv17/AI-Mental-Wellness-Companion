# Serenity AI Environment Variables Example
# Duplicate this file as .env or set these environment variables in your environment.

# Database Credentials
DB_URL=jdbc:postgresql://localhost:5432/mindmate
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password

# JWT Security
JWT_SECRET=mindmate_super_secret_jwt_key_that_must_be_at_least_256_bits_long_for_security_reasons_123456
JWT_EXPIRATION=86400000

# Gmail SMTP Authentication
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key
